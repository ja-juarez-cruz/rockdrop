# ── Terraform ────────────────────────────────────────────────────────────────
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/.terraform.lock.hcl

# Vars de producción — nunca commitear
infra/envs/prod.tfvars

# Build artifacts de lambdas (zips generados por terraform)
infra/modules/lambdas/builds/

# ── Lambda layer ──────────────────────────────────────────────────────────────
# Directorio de build del layer (reconstruido con make build-layer)
lambdas/layers/common/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ── Frontend (app/) ───────────────────────────────────────────────────────────
app/node_modules/
app/dist/

# Variables de entorno locales (contienen URLs de API y WS)
app/.env.local
app/.env.*.local

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

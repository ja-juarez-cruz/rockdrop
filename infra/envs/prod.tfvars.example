# Copia este archivo a prod.tfvars y rellena los valores reales.
# NUNCA commitees prod.tfvars — está en .gitignore.

environment     = "prod"
aws_region      = "us-east-1"
ws_stage        = "prod"
web_bucket_name = "rockdrop-web"
web_app_url     = "https://REPLACE_WITH_CLOUDFRONT_DOMAIN.cloudfront.net"
